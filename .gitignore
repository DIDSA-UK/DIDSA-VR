# Godot 4+ specific ignores
.godot/
/android/

# Never commit the real backend URL/API key — copy secrets.cfg.example to
# secrets.cfg and fill in real values locally, on each dev machine.
secrets.cfg

# Editor/OS cruft
.DS_Store
Thumbs.db
export_presets.cfg

# Local .glb/.gltf models for the tablet's Files tab: often proprietary, so
# they stay on the machine. The folder itself is kept via .gitkeep.
models/*
!models/.gitkeep

# CI run logs
/run.log
/render.log
/.godot-bin/
