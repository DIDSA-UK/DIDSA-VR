# Godot 4+ specific ignores
.godot/
/android/

# Never commit the real backend URL/API key — copy secrets.cfg.example to
# secrets.cfg and fill in real values locally, on each dev machine.
secrets.cfg

# Editor/OS cruft
.DS_Store
Thumbs.db
export_presets.cfg

# Local .glb/.gltf models for the tablet's Files tab: often proprietary, so
# they stay on the machine. The folder itself is kept via .gitkeep.
models/*
!models/.gitkeep

# CI run logs
/run.log
/render.log
/.godot-bin/
/e2e.log
/logs/
/backend.log

# The demo model script's npm packages
/demo/tools/node_modules/
/demo/tools/package*.json

# Logo tracing scratch
/ui/logo/source/node_modules/
/ui/logo/source/masks/
/ui/logo/source/package*.json

# The OpenXR Vendors plugin (tools/install_vendors_plugin.sh): native libraries and AARs, fetched and checked, not committed
/addons/godotopenxrvendors/

# TwoVoip (tools/install_voip_plugin.sh): the Opus voice GDExtension for the P0 voice spike, fetched and checked, not committed
/spikes/voice/addons/
/spikes/voice/.godot/
/addons/twovoip/
