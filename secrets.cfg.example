[backend]
url="http://your-backend-host"
api_key="your-CAD_API_KEY"
# Optional. The backend keeps one document per session id; VR sends its own (a fresh "vr-..." id each launch) so it never
# replaces what the flat app has open. Set one here to keep the same document across restarts, or to share it on purpose.
# document_session="vr-headset-1"

[browser_relay]
# The Browser window's own separate service (DIDSA-CAD repo, browser-relay/)
# - not the CAD backend above. Leave unset to leave the Browser window
# showing "No browser relay set" instead of failing to load. Set up: docs/servers.md
# ("Setting up the Browser"). ws:// or wss://, no /ws (the app adds it).
url="ws://your-relay-host:8100"
api_key="your-BROWSER_RELAY_API_KEY"

[project_store]
# Optional. The project store (DIDSA-CAD repo, project-store/): where server projects live. Its own address and its own key
# (PROJECT_STORE_API_KEY), not the CAD key above. Without it a server project needs the store set on the Servers page. docs/server-projects.md
# url="https://store.example.com"
# api_key="your-PROJECT_STORE_API_KEY"

[session_hub]
# Optional. The session hub (DIDSA-CAD repo, session-hub/): lets this headset HOST a live session (Host Session on the landing). Its own address (ws:// or wss://,
# no /ws) and its own key (SESSION_HUB_API_KEY), not the CAD key. Joining a session needs neither: the join code carries the hub. docs/live-sessions.md
# url="wss://sessions.example.com"
# api_key="your-SESSION_HUB_API_KEY"
