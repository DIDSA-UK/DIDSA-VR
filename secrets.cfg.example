[backend]
url="http://your-backend-host"
api_key="your-CAD_API_KEY"

[browser_relay]
# The Browser window's own separate service (DIDSA-CAD repo, browser-relay/)
# - not the CAD backend above. Leave unset to leave the Browser window
# showing "No browser relay configured" instead of failing to load.
url="ws://your-relay-host:8100"
api_key="your-BROWSER_RELAY_API_KEY"
