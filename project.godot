; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="DIDSA Design Tools VR"
config/description="Build, assemble and model parametric CAD in VR: a Godot 4 OpenXR client for DIDSA-CAD."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
run/main_scene.phone="res://scenes/spikes/cardboard_spike.tscn"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/vsync/vsync_mode=0

[layer_names]

3d_physics/layer_1="world"
3d_physics/layer_2="grabbable"
3d_physics/layer_3="controller"

[physics]

common/physics_ticks_per_second=90
3d/physics_engine="GodotPhysics3D"

[rendering]

renderer/rendering_method="mobile"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=2

[xr]

openxr/enabled=true
openxr/reference_space=1
openxr/foveation_level=0
openxr/startup_alert=false
shaders/enabled=true
openxr/extensions/meta/dynamic_resolution=false
openxr/extensions/meta/passthrough.android=true
openxr/extensions/spatial_entity/enabled.android=true
openxr/extensions/spatial_entity/enable_marker_tracking.android=true
openxr/extensions/spatial_entity/enable_builtin_marker_tracking.android=true
openxr/extensions/meta/passthrough.editor_hint=true
openxr/extensions/spatial_entity/enabled.editor_hint=true
openxr/extensions/spatial_entity/enable_marker_tracking.editor_hint=true
openxr/extensions/spatial_entity/enable_builtin_marker_tracking.editor_hint=true
openxr/enabled.phone=false
openxr/extensions/meta/passthrough.phone=false
openxr/extensions/spatial_entity/enabled.phone=false
openxr/extensions/spatial_entity/enable_marker_tracking.phone=false
openxr/extensions/spatial_entity/enable_builtin_marker_tracking.phone=false
