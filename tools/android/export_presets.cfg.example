; A Quest 3 export preset for DIDSA Design Tools VR (L0, docs/landing-scope.md). export_presets.cfg itself is git-ignored (never commit it: a preset can hold
; signing keys): copy this to export_presets.cfg at the project root, or make the same choices in Project > Export. Godot fills in every option not listed
; here with its default; open the preset in the editor once and check what it shows. Written without a headset or an Android SDK: not yet used to build an APK.
;
; Needs, once: the Android SDK and a JDK 17 set in Editor Settings > Export > Android, the export templates, Project > Install Android Build Template
; (the Gradle build) and tools/install_vendors_plugin.sh (the OpenXR Vendors plugin, then open the project once). Steps: docs/android-build.md.

[preset.0]

name="Quest 3 (debug APK)"
platform="Android"
runnable=true
dedicated_server=false
advanced_options=false
custom_features=""
; every resource, plus the demo glb files and native files (their .import files say "keep": the raw file is packed), without the script that made them and without
; the ~400 test scripts (tests/*; take that out of the exclude list only for the motion benchmark, which reads tests/fixtures/motion_vectors.json).
; NEVER add secrets.cfg here: the APK would carry your API key to everyone you give it to.
export_filter="all_resources"
include_filter="demo/*"
exclude_filter="demo/tools/*, tests/*"
export_path="build/didsa-vr-debug.apk"
patches=PackedStringArray()
encryption_include_filters=""
encryption_exclude_filters=""
seed=0
encrypt_pck=false
encrypt_directory=false
script_export_mode=2

[preset.0.options]

gradle_build/use_gradle_build=true
gradle_build/export_format=0
architectures/arm64-v8a=true
architectures/armeabi-v7a=false
architectures/x86=false
architectures/x86_64=false
package/unique_name="uk.didsa.vr"
package/name="DIDSA Design Tools VR"
package/signed=true
version/code=1
version/name="0.1.0"
; Internet: Godot leaves it OFF by default, and without it every server fails with "Could not reach the server" (Quest 3, 22 Oct 2026)
permissions/internet=true
; XR Mode: 1 = OpenXR
xr_features/xr_mode=1
; the Meta part of the OpenXR Vendors plugin (never tick two vendors in one preset)
xr_features/enable_meta_plugin=true
meta_xr_features/quest_3_support=true
meta_xr_features/quest_2_support=false
meta_xr_features/quest_1_support=false
meta_xr_features/quest_pro_support=false
; Passthrough: 1 = optional, 2 = required. Optional: the app works without it (the Scan page and View > Environment turn it on). The manifest entry for it is
; written only while the project setting xr/openxr/extensions/meta/passthrough reads true IN THE EDITOR at export time: project.godot turns it on with
; .editor_hint (the export) as well as .android (the app on the headset). With only .android the option is hidden and the APK shows black passthrough.
meta_xr_features/passthrough=1
; Spatial entities (the QR scan): the plugin adds com.oculus.permission.USE_SCENE and USE_ANCHOR_API to the manifest by itself while
; xr/openxr/extensions/spatial_entity/enabled is on (project.godot does that for Android builds): nothing to tick here.
